# Copy this file to .env and fill in the real value:
#   cp .env.example .env
#
# WARNING: .env must NEVER be committed — it is listed in .gitignore.
# This file (.env.example) is safe to commit; it contains no real secrets.
#
# The WXT_ prefix is required: WXT (via Vite) only exposes variables prefixed
# with WXT_ to the extension bundle via import.meta.env. Note this means the
# token is bundled into the shipped extension — a known MVP limitation, fixed
# later by the caching proxy (see the Full blueprint).

WXT_PANDASCORE_TOKEN=your_pandascore_token_here
